# Database (Supabase - get from supabase.com > project > settings > database)
DATABASE_URL=""

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk Auth (get from clerk.com > your app > API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# Uploadthing (get from uploadthing.com > your app > API Keys)
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=
