generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id           String     @id @default(cuid())
  token        String     @unique @default(cuid())
  orderRef     String
  recipient    String
  shipmentType String
  notes        String?
  expiresAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  createdBy    String
  docs         Document[]
  scans        Scan[]

  @@index([createdBy])
  @@index([token])
}

model Document {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name       String
  size       Int
  mimeType   String
  extension  String
  docType    String
  fileUrl    String
  uploadedAt DateTime @default(now())

  @@index([orderId])
}

model Scan {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  scannedAt DateTime @default(now())
  userAgent String?
  ipAddress String?

  @@index([orderId])
}
